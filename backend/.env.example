# Variables de entorno del backend — Security Force S.A.C.
# Copiar como .env y completar los valores reales

# Servidor
PORT=3000
NODE_ENV=development

# PostgreSQL (OBLIGATORIA — el servidor no iniciará sin esta variable)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/security_force_db

# SSL para PostgreSQL en producción
DB_SSL=false

# JWT
JWT_SECRET=cambia_este_secreto_en_produccion_usa_openssl_rand_hex_64
JWT_EXPIRES_IN=8h

# CORS — dominio del frontend
CORS_ORIGIN=http://localhost:5173

# Tiempo de expiración de reservas (minutos)
RESERVATION_TIMEOUT_MINUTES=30
